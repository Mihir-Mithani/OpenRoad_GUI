# OpenROAD Flow GUI - Environment Variables Configuration
# Copy this to .env and customize, or export in your shell

# ============================================================
# Project Root (auto-detected if not set)
# ============================================================
# OPENROAD_GUI_ROOT=/path/to/OpenRoad GUI

# ============================================================
# Data Directories
# ============================================================
# Training data output directory (for dataset generation and training scripts)
OPENROAD_DATA_DIR=/path/to/OpenRoad GUI/dataset_genration/output

# Historical data collector database
OPENROAD_DB_PATH=/path/to/OpenRoad GUI/data/training_runs.db

# ============================================================
# Model & Training Artifacts
# ============================================================
# Saved models directory
OPENROAD_MODEL_DIR=/path/to/OpenRoad GUI/openroad_gui/intelligence/models/saved

# Training checkpoints
OPENROAD_CHECKPOINT_DIR=/path/to/OpenRoad GUI/openroad_gui/intelligence/training/checkpoints

# Training logs
OPENROAD_LOG_DIR=/path/to/OpenRoad GUI/openroad_gui/intelligence/training/logs

# ============================================================
# ORFS (OpenROAD Flow Scripts) - Set in GUI Settings dialog
# ============================================================
# ORFS_ROOT=/path/to/OpenROAD-flow-scripts
# OPENROAD_FLOW_SCRIPTS=/path/to/OpenROAD-flow-scripts

# ============================================================
# External Tools - Set in GUI Settings dialog
# ============================================================
# KLayout binary path
# KLAYOUT_CMD=/path/to/klayout

# ============================================================
# Python Environment
# ============================================================
# PYTHONPATH=/path/to/OpenRoad GUI

# ============================================================
# Optional: NVIDIA Data Designer (for dataset generation)
# ============================================================
# NVIDIA_API_KEY=your_api_key_here

# ============================================================
# Optional: WandB (for experiment tracking)
# ============================================================
# WANDB_API_KEY=your_api_key_here
# WANDB_PROJECT=openroad-gui-intelligence