   "source": [
    "# @title 5. Create flow_optimizer.py (State/Action/Reward Definitions)\n",
    "%%writefile /content/flow_optimizer.py\n",
    "\"\"\"RL State/Action space and reward design for OpenROAD flow optimization.\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "from dataclasses import dataclass, field\n",
    "from typing import List, Dict, Optional, Tuple\n",
    "from enum import Enum\n",
    "\n",
    "\n",
    "class FlowStage(Enum):\n",
    "    \"\"\"OpenROAD flow stages in order.\"\"\"\n",
    "    SYNTHESIS = \"synthesis\"\n",
    "    FLOORPLAN = \"floorplan\"\n",
    "    PLACEMENT = \"placement\"\n",
    "    CTS = \"cts\"\n",
    "    ROUTING = \"routing\"\n",
    "    SIGN_OFF = \"signoff\"\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class DesignFeatures:\n",
    "    \"\"\"Static design characteristics (extracted once per design).\"\"\"\n",
    "\n",
    "    # Design complexity\n",
    "    num_instances: int = 0\n",
    "    num_nets: int = 0\n",
    "    num_sequential: int = 0\n",
    "    num_combinational: int = 0\n",
    "    num_ports: int = 0\n",
    "    num_clocks: int = 0\n",
    "    num_macros: int = 0\n",
    "    macro_area_ratio: float = 0.0\n",
    "\n",
    "    # Netlist characteristics\n",
    "    avg_fanout: float = 0.0\n",
    "    max_fanout: int = 0\n",
    "    logic_depth: int = 0\n",
    "    seq_to_comb_ratio: float = 0.0\n",
    "\n",
    "    # Constraints\n",
    "    target_freq_mhz: float = 0.0\n",
    "    utilization_target: float = 0.0\n",
    "    aspect_ratio: float = 1.0\n",
    "    core_margin: float = 0.0\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class StageFeatures:\n",
    "    \"\"\"Dynamic stage-specific features (updated per stage).\"\"\"\n",
    "    stage: FlowStage = FlowStage.SYNTHESIS\n",
    "\n",
    "    # Current PPA metrics (from previous runs or estimates)\n",
    "    current_wns_ns: float = 0.0\n",
    "    current_tns_ns: float = 0.0\n",
    "    current_area_um2: float = 0.0\n",
    "    current_power_mw: float = 0.0\n",
    "    current_drc_violations: int = 0\n",
    "    current_congestion_pct: float = 0.0\n",
    "\n",
    "    # Resource utilization\n",
    "    placement_density: float = 0.0\n",
    "    routing_congestion: float = 0.0\n",
    "    macro_placement_quality: float = 0.0\n",
    "\n",
    "    # Historical context\n",
    "    stage_attempt: int = 0\n",
    "    previous_params: Dict = field(default_factory=dict)\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class FlowState:\n",
    "    \"\"\"Complete RL state representation.\"\"\"\n",
    "    design: DesignFeatures\n",
    "    current_stage: StageFeatures\n",
    "    stage_history: List[StageFeatures] = field(default_factory=list)\n",
    "    global_metrics: Dict[str, float] = field(default_factory=dict)\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class FlowAction:\n",
    "    \"\"\"Discrete action space for flow optimization.\"\"\"\n",
    "\n",
    "    # Synthesis parameters\n",
    "    synth_strategy: int = 1          # 0=area, 1=balanced, 2=timing, 3=power\n",
    "    synth_effort: int = 1            # 0=low, 1=medium, 2=high, 3=extreme\n",
    "    retime: bool = False\n",
    "    resynth: bool = False\n",
    "\n",
    "    # Floorplan/Placement\n",
    "    placement_density: float = 0.6   # 0.4 - 0.8\n",
    "    placement_effort: int = 1        # 0=low, 1=medium, 2=high, 3=extreme\n",
    "    macro_placement: int = 0         # 0=auto, 1=manual, 2=hierarchical\n",
    "\n",
    "    # CTS\n",
    "    cts_skew_target: float = 0.05    # 0.01 - 0.1 ns\n",
    "    cts_buffer_type: int = 0         # Buffer cell selection\n",
    "    cts_clustering: int = 0          # Clustering algorithm\n",
    "\n",
    "    # Routing\n",
    "    routing_layers: int = 6          # 4 - 8\n",
    "    routing_effort: int = 1          # 0=low, 1=medium, 2=high, 3=extreme\n",
    "    detour_scale: float = 1.0        # 0.5 - 2.0\n",
    "\n",
    "    # Sign-off\n",
    "    signoff_effort: int = 1          # 0=low, 1=medium, 2=high\n",
    "\n",
    "    def to_array(self) -> np.ndarray:\n",
    "        return np.array([\n",
    "            self.synth_strategy, self.synth_effort, float(self.retime), float(self.resynth),\n",
    "            self.placement_density, self.placement_effort, self.macro_placement,\n",
    "            self.cts_skew_target, self.cts_buffer_type, self.cts_clustering,\n",
    "            self.routing_layers, self.routing_effort, self.detour_scale,\n",
    "            self.signoff_effort,\n",
    "        ], dtype=np.float32)\n",
    "\n",
    "    @classmethod\n",
    "    def from_array(cls, arr: np.ndarray) -> \"FlowAction\":\n",
    "        return cls(\n",
    "            synth_strategy=int(arr[0]),\n",
    "            synth_effort=int(arr[1]),\n",
    "            retime=bool(arr[2]),\n",
    "            resynth=bool(arr[3]),\n",
    "            placement_density=float(arr[4]),\n",
    "            placement_effort=int(arr[5]),\n",
    "            macro_placement=int(arr[6]),\n",
    "            cts_skew_target=float(arr[7]),\n",
    "            cts_buffer_type=int(arr[8]),\n",
    "            cts_clustering=int(arr[9]),\n",
    "            routing_layers=int(arr[10]),\n",
    "            routing_effort=int(arr[11]),\n",
    "            detour_scale=float(arr[12]),\n",
    "            signoff_effort=int(arr[13]),\n",
    "        )\n",
    "\n",
    "\n",
    "class StateEncoder:\n",
    "    \"\"\"Encode FlowState to fixed-size vector for neural network.\"\"\"\n",
    "\n",
    "    STATE_DIM = 128\n",
    "\n",
    "    def encode(self, state: FlowState) -> np.ndarray:\n",
    "        features = []\n",
    "\n",
    "        # Design features (14 dims)\n",
    "        d = state.design\n",
    "        features.extend([\n",
    "            np.log1p(d.num_instances) / 20.0,\n",
    "            np.log1p(d.num_nets) / 20.0,\n",
    "            d.num_sequential / max(1, d.num_instances),\n",
    "            d.num_macros / max(1, d.num_instances),\n",
    "            d.macro_area_ratio,\n",
    "            d.avg_fanout / 10.0,\n",
    "            d.max_fanout / 100.0,\n",
    "            d.logic_depth / 50.0,\n",
    "            d.seq_to_comb_ratio,\n",
    "            d.target_freq_mhz / 1000.0,\n",
    "            d.utilization_target / 100.0,\n",
    "            d.aspect_ratio / 2.0,\n",
    "            d.core_margin / 10.0,\n",
    "        ])\n",
    "\n",
    "        # Current stage features (12 dims)\n",
    "        s = state.current_stage\n",
    "        features.extend([\n",
    "            np.clip(s.current_wns_ns / 100.0, -1, 1),\n",
    "            np.clip(s.current_tns_ns / 1000.0, -1, 1),\n",
    "            np.log1p(max(1, s.current_area_um2)) / 20.0,\n",
    "            np.log1p(max(1, s.current_power_mw)) / 20.0,\n",
    "            min(s.current_drc_violations / 100.0, 1.0),\n",
    "            s.current_congestion_pct / 100.0,\n",
    "            s.placement_density,\n",
    "            s.routing_congestion,\n",
    "            s.macro_placement_quality,\n",
    "            s.stage_attempt / 5.0,\n",
    "            float(s.stage == FlowStage.SYNTHESIS),\n",
    "            float(s.stage == FlowStage.ROUTING),\n",
    "        ])\n",
    "\n",
    "        # Stage history (3 stages × 8 dims = 24 dims)\n",
    "        for hist in state.stage_history[-3:]:\n",
    "            features.extend([\n",
    "                np.clip(hist.current_wns_ns / 100.0, -1, 1),\n",
    "                np.clip(hist.current_tns_ns / 1000.0, -1, 1),\n",
    "                np.log1p(max(1, hist.current_area_um2)) / 20.0,\n",
    "                float(hist.stage == FlowStage.SYNTHESIS),\n",
    "                float(hist.stage == FlowStage.FLOORPLAN),\n",
    "                float(hist.stage == FlowStage.PLACEMENT),\n",
    "                float(hist.stage == FlowStage.CTS),\n",
    "                float(hist.stage == FlowStage.ROUTING),\n",
    "            ])\n",
    "\n",
    "        # Pad to STATE_DIM\n",
    "        while len(features) < self.STATE_DIM:\n",
    "            features.append(0.0)\n",
    "\n",
    "        return np.array(features[:self.STATE_DIM], dtype=np.float32)\n",
    "\n",
    "\n",
    "class FlowReward:\n",
    "    \"\"\"Reward function for PPO training.\"\"\"\n",
    "\n",
    "    def __init__(self, weights: Dict[str, float]):\n",
    "        self.weights = weights\n",
    "\n",
    "    def compute(self, prev_ppa: Dict, curr_ppa: Dict, runtime: float) -> float:\n",
    "        if not prev_ppa:\n",
    "            return 0.0\n",
    "\n",
    "        reward = 0.0\n",
    "\n",
    "        # WNS improvement (most important)\n",
    "        wns_delta = curr_ppa[\"wns\"] - prev_ppa[\"wns\"]\n",
    "        reward += self.weights.get(\"wns\", 0.30) * wns_delta\n",
    "\n",
    "        # TNS improvement\n",
    "        tns_delta = curr_ppa[\"tns\"] - prev_ppa[\"tns\"]\n",
    "        reward += self.weights.get(\"tns\", 0.15) * (tns_delta / 10.0)\n",
    "\n",
    "        # Area reduction (smaller is better)\n",
    "        if prev_ppa[\"area\"] > 0:\n",
    "            area_ratio = curr_ppa[\"area\"] / prev_ppa[\"area\"]\n",
    "            reward += self.weights.get(\"area\", 0.15) * (1.0 - area_ratio)\n",
    "\n",
    "        # Power reduction\n",
    "        if prev_ppa[\"power\"] > 0:\n",
    "            power_ratio = curr_ppa[\"power\"] / prev_ppa[\"power\"]\n",
    "            reward += self.weights.get(\"power\", 0.10) * (1.0 - power_ratio)\n",
    "\n",
    "        # DRC violations reduction\n",
    "        drc_delta = prev_ppa.get(\"drc\", 0) - curr_ppa.get(\"drc\", 0)\n",
    "        reward += self.weights.get(\"drc\", 0.15) * drc_delta\n",
    "\n",
    "        # Congestion reduction\n",
    "        cong_delta = prev_ppa.get(\"congestion\", 0) - curr_ppa.get(\"congestion\", 0)\n",
    "        reward += self.weights.get(\"congestion\", 0.10) * cong_delta\n",
    "\n",
    "        # Runtime penalty\n",
    "        reward -= self.weights.get(\"runtime\", 0.05) * (runtime / 1000.0)\n",
    "\n",
    "        # Bonus for timing closure\n",
    "        if curr_ppa[\"wns\"] >= 0 and prev_ppa[\"wns\"] < 0:\n",
    "            reward += 10.0\n",
    "\n",
    "        # Bonus for DRC clean\n",
    "        if curr_ppa.get(\"drc\", 1) == 0 and prev_ppa.get(\"drc\", 1) > 0:\n",
    "            reward += 5.0\n",
    "\n",
    "        return float(reward)\n"
   ]
