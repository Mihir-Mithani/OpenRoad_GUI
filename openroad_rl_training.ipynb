    "# @title 6. Create onnx_export.py (Surrogate Inference Engine)\n",
    "%%writefile /content/onnx_export.py\n",
    "\"\"\"ONNX export and inference for surrogate models.\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from pathlib import Path\n",
    "from typing import Dict, Any, Optional, List\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "from sklearn.compose import ColumnTransformer\n",
    "\n",
    "try:\n",
    "    import lightgbm as lgb\n",
    "    HAS_LGB = True\n",
    "except ImportError:\n",
    "    HAS_LGB = False\n",
    "\n",
    "# ─── Model Definitions ───────────────────────────────────────────────────\n",
    "\n",
    "class MLPRegressor(nn.Module):\n",
    "    \"\"\"PyTorch MLP matching training architecture.\"\"\"\n",
    "\n",
    "    def __init__(self, input_dim: int, hidden_dims=(256, 128, 64), dropout=0.2):\n",
    "        super().__init__()\n",
    "        layers = []\n",
    "        prev_dim = input_dim\n",
    "        for h in hidden_dims:\n",
    "            layers.append(nn.Linear(prev_dim, h))\n",
    "            layers.append(nn.BatchNorm1d(h))\n",
    "            layers.append(nn.ReLU())\n",
    "            layers.append(nn.Dropout(dropout))\n",
    "            prev_dim = h\n",
    "        layers.append(nn.Linear(prev_dim, 1))\n",
    "        self.net = nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.net(x).squeeze(-1)\n",
    "\n",
    "\n",
    "# ─── Surrogate Inference ─────────────────────────────────────────────────\n",
    "\n",
    "class SurrogateInference:\n",
    "    \"\"\"Load and run ensemble surrogate models (LightGBM + MLP).\"\"\"\n",
    "\n",
    "    def __init__(self, model_dir: Path):\n",
    "        self.model_dir = Path(model_dir)\n",
    "        self.lgb_models: Dict[str, Any] = {}\n",
    "        self.mlp_models: Dict[str, nn.Module] = {}\n",
    "        self.preprocessor = None\n",
    "        self.input_dim = None\n",
    "        self.targets = ['wns', 'tns', 'area', 'power']\n",
    "        self._load_all()\n",
    "\n",
    "    def _load_all(self):\n",
    "        \"\"\"Load preprocessor and all models.\"\"\"\n",
    "\n",
    "        # Load preprocessor\n",
    "        preprocessor_path = self.model_dir / \"surrogate_preprocessor_v2.pkl\"\n",
    "        if preprocessor_path.exists():\n",
    "            self.preprocessor = joblib.load(preprocessor_path)\n",
    "            # Get input dim from preprocessor\n",
    "            if hasattr(self.preprocessor, 'transformers_'):\n",
    "                # Estimate output dimension\n",
    "                pass\n",
    "            print(f\"✅ Loaded preprocessor from {preprocessor_path}\")\n",
    "        else:\n",
    "            print(f\"⚠️ Preprocessor not found at {preprocessor_path}\")\n",
    "\n",
    "        # Load LightGBM models\n",
    "        for target in self.targets:\n",
    "            lgb_path = self.model_dir / f\"surrogate_{target}_lgb.pkl\"\n",
    "            if lgb_path.exists():\n",
    "                model_data = joblib.load(lgb_path)\n",
    "                if isinstance(model_data, dict):\n",
    "                    self.lgb_models[target] = model_data.get('model', model_data)\n",
    "                else:\n",
    "                    self.lgb_models[target] = model_data\n",
    "                print(f\"✅ Loaded LGB {target}: {lgb_path.name}\")\n",
    "            else:\n",
    "                print(f\"⚠️ LGB {target} not found: {lgb_path}\")\n",
    "\n",
    "            mlp_path = self.model_dir / f\"surrogate_{target}_mlp.pt\"\n",
    "            if mlp_path.exists():\n",
    "                checkpoint = torch.load(mlp_path, map_location='cpu')\n",
    "                input_dim = checkpoint.get('input_dim', 16)\n",
    "                self.input_dim = input_dim\n",
    "                model = MLPRegressor(input_dim)\n",
    "                model.load_state_dict(checkpoint['model_state'])\n",
    "                model.eval()\n",
    "                self.mlp_models[target] = model\n",
    "                print(f\"✅ Loaded MLP {target}: {mlp_path.name}\")\n",
    "            else:\n",
    "                print(f\"⚠️ MLP {target} not found: {mlp_path}\")\n",
    "\n",
    "    def _prepare_features(self, features: Dict[str, Any]) -> np.ndarray:\n",
    "        \"\"\"Convert feature dict to model-ready array.\"\"\"\n",
    "        expected = [\n",
    "            'core_utilization', 'core_margin', 'num_instances', 'num_nets',\n",
    "            'num_sequential', 'num_macros', 'macro_area_ratio',\n",
    "            'log_instances', 'log_nets', 'seq_ratio', 'macro_ratio',\n",
    "            'platform_gf180', 'platform_nangate45', 'platform_sky130hd'\n",
    "        ]\n",
    "\n",
    "        # Build feature vector in correct order\n",
    "        vec = []\n",
    "        for feat in expected:\n",
    "            vec.append(features.get(feat, 0.0))\n",
    "        \n",
    "        arr = np.array([vec], dtype=np.float32)\n",
    "\n",
    "        # Apply preprocessor if available\n",
    "        if self.preprocessor is not None:\n",
    "            try:\n",
    "                arr = self.preprocessor.transform(arr)\n",
    "            except Exception as e:\n",
    "                print(f\"Preprocessor transform failed: {e}\")\n",
    "\n",
    "        return arr\n",
    "\n",
    "    def predict_lgb(self, features: Dict[str, Any]) -> Dict[str, float]:\n",
    "        \"\"\"Predict using LightGBM models only.\"\"\"\n",
    "        X = self._prepare_features(features)\n",
    "        results = {}\n",
    "        for target, model in self.lgb_models.items():\n",
    "            try:\n",
    "                pred = model.predict(X)\n",
    "                # Inverse transform for area/power (were log-transformed)\n",
    "                if target in ['area', 'power']:\n",
    "                    pred = np.expm1(pred)\n",
    "                results[target] = float(pred[0])\n",
    "            except Exception as e:\n",
    "                print(f\"LGB {target} prediction failed: {e}\")\n",
    "                results[target] = 0.0\n",
    "        return results\n",
    "\n",
    "    def predict_mlp(self, features: Dict[str, Any]) -> Dict[str, float]:\n",
    "        \"\"\"Predict using MLP models only.\"\"\"\n",
    "        X = self._prepare_features(features)\n",
    "        results = {}\n",
    "        for target, model in self.mlp_models.items():\n",
    "            try:\n",
    "                with torch.no_grad():\n",
    "                    pred = model(torch.FloatTensor(X)).numpy()\n",
    "                if target in ['area', 'power']:\n",
    "                    pred = np.expm1(pred)\n",
    "                results[target] = float(pred[0])\n",
    "            except Exception as e:\n",
    "                print(f\"MLP {target} prediction failed: {e}\")\n",
    "                results[target] = 0.0\n",
    "        return results\n",
    "\n",
    "    def predict_ensemble(self, features: Dict[str, Any]) -> Dict[str, float]:\n",
    "        \"\"\"Predict using ensemble average of LGB + MLP.\"\"\"\n",
    "        lgb_pred = self.predict_lgb(features)\n",
    "        mlp_pred = self.predict_mlp(features)\n",
    "\n",
    "        results = {}\n",
    "        for target in self.targets:\n",
    "            lgb_val = lgb_pred.get(target, 0.0)\n",
    "            mlp_val = mlp_pred.get(target, 0.0)\n",
    "            # Average if both available, else use whichever exists\n",
    "            if target in self.lgb_models and target in self.mlp_models:\n",
    "                results[target] = (lgb_val + mlp_val) / 2.0\n",
    "            elif target in self.lgb_models:\n",
    "                results[target] = lgb_val\n",
    "            elif target in self.mlp_models:\n",
    "                results[target] = mlp_val\n",
    "            else:\n",
    "                results[target] = 0.0\n",
    "\n",
    "        return results\n",
    "\n",
    "\n",
    "# ─── ONNX Export ─────────────────────────────────────────────────────────\n",
    "\n",
    "class ONNXExporter:\n",
    "    \"\"\"Export PyTorch models to ONNX format.\"\"\"\n",
    "\n",
    "    def __init__(self, model_dir: Path):\n",
    "        self.model_dir = Path(model_dir)\n",
    "\n",
    "    def export_mlp_to_onnx(self, target: str, output_path: Optional[Path] = None) -> Path:\n",
    "        \"\"\"Export single MLP to ONNX.\"\"\"\n",
    "        mlp_path = self.model_dir / f\"surrogate_{target}_mlp.pt\"\n",
    "        if not mlp_path.exists():\n",
    "            raise FileNotFoundError(f\"MLP model not found: {mlp_path}\")\n",
    "\n",
    "        checkpoint = torch.load(mlp_path, map_location='cpu')\n",
    "        input_dim = checkpoint.get('input_dim', 16)\n",
    "        model = MLPRegressor(input_dim)\n",
    "        model.load_state_dict(checkpoint['model_state'])\n",
    "        model.eval()\n",
    "\n",
    "        if output_path is None:\n",
    "            output_path = self.model_dir / f\"surrogate_{target}_mlp.onnx\"\n",
    "\n",
    "        dummy_input = torch.randn(1, input_dim)\n",
    "        torch.onnx.export(\n",
    "            model,\n",
    "            dummy_input,\n",
    "            output_path,\n",
    "            export_params=True,\n",
    "            opset_version=14,\n",
    "            do_constant_folding=True,\n",
    "            input_names=['input'],\n",
    "            output_names=['output'],\n",
    "            dynamic_axes={'input': {0: 'batch_size'}, 'output': {0: 'batch_size'}},\n",
    "        )\n",
    "        print(f\"✅ Exported {target} MLP to {output_path}\")\n",
    "        return output_path\n",
    "\n",
    "    def export_all_mlp(self) -> List[Path]:\n",
    "        \"\"\"Export all MLP models to ONNX.\"\"\"\n",
    "        targets = ['wns', 'tns', 'area', 'power']\n",
    "        paths = []\n",
    "        for target in targets:\n",
    "            try:\n",
    "                paths.append(self.export_mlp_to_onnx(target))\n",
    "            except Exception as e:\n",
    "                print(f\"Failed to export {target}: {e}\")\n",
    "        return paths\n",
    "\n",
    "\n",
    "class ONNXInferenceEngine:\n",
    "    \"\"\"Run inference using ONNX Runtime.\"\"\"\n",
    "\n",
    "    def __init__(self, model_path: Path):\n",
    "        try:\n",
    "            import onnxruntime as ort\n",
    "            self.session = ort.InferenceSession(str(model_path))\n",
    "            self.input_name = self.session.get_inputs()[0].name\n",
    "            self.output_name = self.session.get_outputs()[0].name\n",
    "        except ImportError:\n",
    "            raise RuntimeError(\"onnxruntime not installed. Run: pip install onnxruntime\")\n",
    "\n",
    "    def predict(self, features: np.ndarray) -> np.ndarray:\n",
    "        return self.session.run([self.output_name], {self.input_name: features.astype(np.float32)})[0]\n"
   ]
  },
